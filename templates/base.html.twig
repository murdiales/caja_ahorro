<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Caja de Ahorro{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🏦</text></svg>">

    {# Bootstrap 5 CSS CDN #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    {# Bootstrap Icons #}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-light">

    {% if app.user %}
    {# Navbar Menú Principal #}
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold text-success" href="{{ path('app_home') }}">
                🏦 Caja de Ahorro
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    {# Inicio #}
                    <li class="nav-item">
                        <a class="nav-link active" href="{{ path('app_home') }}">
                            <i class="bi bi-house-door-fill"></i> Ventanilla
                        </a>
                    </li>

                    {# Documentos Institucionales #}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_document_index') }}">
                            <i class="bi bi-file-earmark-pdf-fill"></i> Docs
                        </a>
                    </li>

                    {# Módulo 1: Administración de Cuentas #}
                    {% if is_granted('ROLE_ADMIN') %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-people-fill"></i> Adm. de Cuentas
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-menu-title dropdown-header" href="#">Cuentas de Ahorro</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_account_index') }}">Lista de Cuentas</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_account_new') }}">Nueva Cuenta</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-menu-title dropdown-header" href="#">Administración</a></li>
                            <li><a class="dropdown-item" href="/admin?crudAction=index">Panel EasyAdmin</a></li>
                        </ul>
                    </li>
                    {% endif %}

                    {# Módulo 2: Transacciones #}
                    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_TESORERO') %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-cash-stack"></i> Transacciones
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="{{ path('app_transaction_index') }}">Historial de Transacciones</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_transaction_new') }}">Nueva Transacción</a></li>
                            <li><a class="dropdown-item disabled" href="#">Reporte Diario</a></li>
                        </ul>
                    </li>
                    {% endif %}

                    {# Módulo 3: Préstamos #}
                    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_TESORERO') %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-bank"></i> Préstamos
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="{{ path('app_loan_index') }}">Lista de Préstamos</a></li>
                            <li><a class="dropdown-item" href="{{ path('loan_simulator') }}">Simulador de Préstamos</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_loan_new') }}">Nuevo Préstamo</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="{{ path('app_loan_installment_index') }}">Cuotas / Pagos</a></li>
                        </ul>
                    </li>
                    {% endif %}

                    {# Módulo 4: Gestión Financiera #}
                    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_TESORERO') %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-cash-coin"></i> Gestión Financiera
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="{{ path('app_financial_index') }}">Resumen Financiero</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item disabled" href="#">Intereses Generados</a></li>
                            <li><a class="dropdown-item disabled" href="#">Cierre Mensual</a></li>
                            <li><a class="dropdown-item disabled" href="#">Estadísticas</a></li>
                        </ul>
                    </li>
                    {% endif %}

                    {# Módulo 5: Gestión Documental e Historial de Correos #}
                    {% if is_granted('ROLE_ADMIN') %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-folder-symlink-fill"></i> Gestión
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="{{ path('app_document_index') }}">Documentos</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_email_log_index') }}">Historial de Correos</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_user_index') }}">Usuarios del Sistema</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item disabled" href="#">Configuración Global</a></li>
                            <li><a class="dropdown-item disabled" href="#">Logs de Sistema</a></li>
                            <li><a class="dropdown-item disabled" href="#">Respaldos BD</a></li>
                        </ul>
                    </li>
                    {% endif %}

                    {# Opción directa para Configurar el Sitio Web #}
                    {% if is_granted('ROLE_ADMIN') %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_site_config_index') }}">
                            <i class="bi bi-sliders"></i> Config. Portal Web
                        </a>
                    </li>
                    {% endif %}
                </ul>

                {# Usuario activo y Logout #}
                <div class="d-flex align-items-center gap-3">
                    <span class="navbar-text text-light small">
                        <i class="bi bi-person-circle"></i> {{ app.user.firstname ?? app.user.userIdentifier }}
                    </span>
                    <a href="{{ path('app_logout') }}" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-box-arrow-right"></i> Salir
                    </a>
                </div>
            </div>
        </div>
    </nav>
    {% endif %}

    <main class="py-4">
        <div class="container">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        </div>

        {% block body %}{% endblock %}
    </main>

    {# Bootstrap 5 JS CDN #}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
