<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Caja de Ahorro{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🏦</text></svg>">

    {# Bootstrap 5 CSS CDN #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    {# Bootstrap Icons #}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-light">

<div class="text-white text-center fw-bold py-1
    {% if app.environment == 'prod' %}
        bg-success
    {% else %}
        bg-danger
    {% endif %}
">
    ENTORNO {{ app.environment|upper }}
</div>



{# El Menú de Navegación SÓLO se muestra si el usuario inició sesión #}
{% if app.user %}
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold text-success" href="{{ path('app_home') }}">
                <i class="bi bi-bank me-2"></i>Caja de Ahorro
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    {# Inicio #}
                    <li class="nav-item">
                        <a class="nav-link active" href="{{ path('app_home') }}">
                            <i class="bi bi-house-door-fill"></i> Ventanilla
                        </a>
                    </li>

                    {# Módulo 1: Administración de Cuentas / Gestión de Socios #}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-people-fill"></i> Adm. de Cuentas
                        </a>
                        <ul class="dropdown-menu">
                            <li><h6 class="dropdown-header">Gestión de Socios</h6></li>
                            <li>
                                <a class="dropdown-item" href="{{ path('app_user_new') }}">
                                    <i class="bi bi-person-plus-fill text-success me-1"></i> Nuevo Socio
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="{{ path('app_user_index') }}">
                                    <i class="bi bi-people-fill text-primary me-1"></i> Lista de Socios
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li><h6 class="dropdown-header">Administración</h6></li>
                            <li>
                                <a class="dropdown-item" href="/admin?crudAction=index">
                                    <i class="bi bi-gear-fill me-1"></i> Panel Admin EasyAdmin
                                </a>
                            </li>
                        </ul>
                    </li>

                    {# Módulo 2: Transacciones #}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-cash-stack"></i> Transacciones
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="{{ path('app_transaction_deposit') }}">Depósito</a></li>
                            <li><a class="dropdown-item disabled" href="#">Retiro</a></li>
                            <li><a class="dropdown-item disabled" href="#">Historial</a></li>
                        </ul>
                    </li>

                    {# Módulo 3: Préstamos #}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-bank"></i> Préstamos
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="{{ path('loan_requests') }}">Solicitudes</a></li>
                            <li><a class="dropdown-item" href="{{ path('loan_simulator') }}">Simulador</a></li>
                        </ul>
                    </li>

                    {# Módulo 4: Informes Financieros (Ruta desactivada temporalmente para evitar RouteNotFoundException) #}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-file-earmark-bar-graph-fill"></i> Informes
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item disabled" href="#">General</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item disabled" href="#">Reporte de Saldos</a></li>
                            <li><a class="dropdown-item disabled" href="#">Reporte de Morosidad</a></li>
                        </ul>
                    </li>

                    {# Módulo 5: Gestión Documental e Historial de Correos (Rutas desactivadas temporalmente) #}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-folder-symlink-fill"></i> Gestión
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item disabled" href="#">Documentos</a></li>
                            <li><a class="dropdown-item disabled" href="#">Logs de Email</a></li>
                        </ul>
                    </li>

                    {# Configuración del Sitio Web #}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_site_config_index') }}">
                            <i class="bi bi-sliders"></i> Config. Portal Web
                        </a>
                    </li>

                </ul>

                {# Usuario activo y Logout #}
                <div class="d-flex align-items-center gap-3">
                    <span class="navbar-text text-light small">
                        <i class="bi bi-person-circle"></i> {{ app.user.firstName }}
                    </span>
                    <a href="{{ path('app_logout') }}" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-box-arrow-right"></i> Salir
                    </a>
                </div>
            </div>
        </div>
    </nav>
{% endif %}

{# Bloque principal de contenido accesible para usuarios autenticados y visitantes #}
<main class="py-4">
    {% block body %}{% endblock %}
</main>

{# Bootstrap 5 JS CDN #}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
