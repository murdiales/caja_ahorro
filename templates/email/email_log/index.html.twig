{% extends 'base.html.twig' %}

{% block title %}Historial de Correos Enviados{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white fw-bold d-flex justify-content-between align-items-center">
            <span><i class="bi bi-mailbox me-2"></i>Historial de Correos Enviados</span>
            <span class="badge bg-light text-primary">{{ logs|length }} Record(s)</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 text-center">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Destinatario</th>
                            <th>Asunto</th>
                            <th>Fecha de Envío</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for log in logs %}
                            <tr>
                                <td>{{ log.id }}</td>
                                <td class="fw-bold text-start">{{ log.recipientEmail ?? 'N/A' }}</td>
                                <td class="text-start">{{ log.subject }}</td>
                                <td>{{ log.sentAt ? log.sentAt|date('d/m/Y H:i:s') : 'N/A' }}</td>
                                <td>
                                    {% if log.status == 'SUCCESS' or log.status == 'ENVIADO' %}
                                        <span class="badge bg-success">Enviado</span>
                                    {% else %}
                                        <span class="badge bg-danger">Error</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-muted py-4">No hay registro de correos enviados en el sistema.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}