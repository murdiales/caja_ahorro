{% extends 'base.html.twig' %}

{% block title %}Gestión de Usuarios{% endblock %}

{% block body %}
<div class="container mt-4">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-primary mb-0">👥 Gestión de Usuarios y Socios</h3>
        <a href="{{ path('app_user_new') }}" class="btn btn-success fw-bold shadow-sm">
            <i class="bi bi-person-plus-fill"></i> Crear Nuevo Usuario
        </a>
    </div>

    {# Buscador dinámico antes de la tabla #}
    <div class="row mb-3">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text">
                    <i class="bi bi-search"></i>
                </span>
                <input
                    type="text"
                    id="userSearch"
                    class="form-control"
                    placeholder="Buscar por cédula, nombre o correo..."
                >
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Nº</th>
                            <th>Cédula</th>
                            <th>Nombre Completo</th>
                            <th>Correo Electrónico</th>
                            <th>Rol Asignado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                            <tr>
                                <td><code>#{{ user.id }}</code></td>
                                <td><code>{{ user.identificationNumber }}</code></td>
                                <td class="fw-bold">{{ user.firstName }} {{ user.lastName }}</td>
                                <td>{{ user.email }}</td>
                                <td>
                                    {% if 'ROLE_ADMIN' in user.roles %}
                                        <span class="badge bg-danger">ADMINISTRADOR</span>
                                    {% elseif 'ROLE_TREASURY' in user.roles %}
                                        <span class="badge bg-warning text-dark">TESORERO</span>
                                    {% elseif 'ROLE_SECRETARY' in user.roles %}
                                        <span class="badge bg-info text-white">SECRETARIO</span>
                                    {% else %}
                                        <span class="badge bg-secondary">SOCIO / CLIENTE</span>
                                    {% endif %}
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        {# Botón Reenviar Correo #}
                                        <form method="post" action="{{ path('app_user_resend_email', {id: user.id}) }}">
                                            <button type="submit"
                                                    class="btn btn-outline-info btn-sm"
                                                    title="Reenviar Correo">
                                                <i class="bi bi-envelope-at-fill"></i>
                                            </button>
                                        </form>

                                        {# Botón Editar #}
                                        <a href="{{ path('app_user_edit', {id: user.id}) }}" class="btn btn-outline-warning btn-sm" title="Editar">
                                            ✏️ Editar
                                        </a>

                                        {# Botón Eliminar #}
                                        <form method="post" action="{{ path('app_user_delete', {id: user.id}) }}" onsubmit="return confirm('¿Está seguro de eliminar este usuario?');">
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Eliminar">
                                                🗑️ Eliminar
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">No se encontraron usuarios registrados.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

{# Script JS para filtrado en tiempo real #}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('userSearch');
    if (!searchInput) return;
    searchInput.addEventListener('keyup', function () {
        const value = this.value.toLowerCase();
        document.querySelectorAll('table tbody tr').forEach(function(row) {
            const text = row.textContent.toLowerCase();
            if (text.includes(value)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    });
});
</script>
{% endblock %}
