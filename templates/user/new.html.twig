{% extends 'base.html.twig' %}

{% block title %}Crear Usuario{% endblock %}

{% block body %}
<div class="container mt-4" style="max-width: 650px;">
    <div class="card shadow border-0">
        <div class="card-header bg-success text-white fw-bold">
            <h4 class="mb-0">👤 Crear Nuevo Usuario / Socio</h4>
        </div>
        <div class="card-body p-4">
            <form method="post">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="firstName" class="form-label fw-bold">Nombre</label>
                        <input type="text" id="firstName" name="firstName" class="form-control" required placeholder="Ej. Juan">
                    </div>

                    <div class="col-md-6">
                        <label for="lastName" class="form-label fw-bold">Apellido</label>
                        <input type="text" id="lastName" name="lastName" class="form-control" required placeholder="Ej. Pérez">
                    </div>

                    <div class="col-md-6">
                        <label for="identificationNumber" class="form-label fw-bold">Cédula / Identificación</label>
                        <input type="text" id="identificationNumber" name="identificationNumber" class="form-control" required placeholder="1714882949">
                    </div>

                    <div class="col-md-6">
                        <label for="joinedAt" class="form-label fw-bold">Fecha de Ingreso (Socio)</label>
                        <input type="date" id="joinedAt" name="joinedAt" class="form-control" value="{{ "now"|date("Y-m-d") }}" required>
                        <div class="form-text">Define el código de la cuenta (Año + Mes).</div>
                    </div>

                    <div class="col-md-6">
                        <label for="role" class="form-label fw-bold">Rol en el Sistema</label>
                        <select id="role" name="role" class="form-select" required>
                            <option value="ROLE_USER" selected>Socio / Cliente (ROLE_USER)</option>
                            <option value="ROLE_SECRETARY">Secretaría (ROLE_SECRETARY)</option>
                            <option value="ROLE_TREASURY">Tesorería (ROLE_TREASURY)</option>
                            <option value="ROLE_ADMIN">Administrador (ROLE_ADMIN)</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label for="email" class="form-label fw-bold">Correo Electrónico</label>
                        <input type="email" id="email" name="email" class="form-control" required placeholder="correo@ejemplo.com">
                    </div>
                </div>

                <div class="d-flex justify-content-between pt-4">
                    <a href="{{ path('app_user_index') }}" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-success fw-bold">Guardar Usuario y Notificar</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}