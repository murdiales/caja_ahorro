{% extends 'base.html.twig' %}

{% block title %}Detalle de Cuenta - {{ account.accountNumber }}{% endblock %}

{% block body %}
<div class="container mt-4">
    {# Mensajes de Notificación #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {# Botonera de Acciones Superior #}
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <a href="{{ path('app_home') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Volver a la Ventanilla
        </a>

        <div class="d-flex gap-2 flex-wrap">
            {# 1. Realizar Depósito #}
            <a href="{{ path('app_transaction_deposit') }}?account_id={{ account.id }}" class="btn btn-success fw-bold shadow-sm">
                💵 Realizar Depósito
            </a>

            {# 2. Realizar Retiro #}
            <a href="{{ path('app_transaction_withdraw') }}?account_id={{ account.id }}" class="btn btn-warning text-dark fw-bold shadow-sm">
                💸 Realizar Retiro
            </a>

            {# 3. Solicitar Préstamo (HABILITADO) #}
            <a href="{{ path('app_loan_request') }}?account_id={{ account.id }}" class="btn btn-info text-white fw-bold shadow-sm">
                📋 Solicitar Préstamo
            </a>

            {# 4. Estado de Cuenta #}
            <a href="{{ path('app_account_transactions', {id: account.id}) }}" class="btn btn-dark fw-bold shadow-sm">
                📄 Estado de Cuenta (6 meses)
            </a>
        </div>
    </div>

    <div class="row g-4">
        {# Tarjeta 1: Información del Socio y Saldo #}
        <div class="col-md-5">
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-dark text-white fw-bold">
                    <i class="bi bi-person-vcard-fill"></i> Información del Socio
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item"><strong>Nombre:</strong> {{ account.user.firstName }} {{ account.user.lastName }}</li>
                        <li class="list-group-item"><strong>Cédula:</strong> <code>{{ account.user.identificationNumber }}</code></li>
                        <li class="list-group-item"><strong>Correo:</strong> {{ account.user.email }}</li>
                    </ul>
                </div>
            </div>

            <div class="card shadow-sm border-0 text-center bg-white p-3">
                <span class="text-muted text-uppercase small fw-bold">Saldo Disponible</span>
                <h1 class="text-success display-5 fw-bold my-1">${{ account.currentBalance|number_format(2, '.', ',') }}</h1>
                <span class="badge bg-primary fs-6 mx-auto">Nº {{ account.accountNumber }}</span>
            </div>
        </div>

        {# Tarjeta 2: Historial de Movimientos #}
        <div class="col-md-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white fw-bold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-clock-history"></i> Últimos 10 Movimientos</span>
                    <span class="badge bg-light text-dark">{{ recentTransactions|length }} mostrado(s)</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Fecha</th>
                                    <th>Tipo</th>
                                    <th>Motivo / Descripción</th>
                                    <th class="text-end">Monto</th>
                                    <th class="text-center">Comprobante</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for tx in recentTransactions %}
                                    <tr>
                                        <td class="small">{{ tx.createdAt|date('Y-m-d H:i') }}</td>
                                        <td>
                                            {% if tx.type == 'DEPOSIT' %}
                                                <span class="badge bg-success-subtle text-success border border-success">DEPÓSITO</span>
                                            {% elseif tx.type == 'WITHDRAWAL' %}
                                                <span class="badge bg-danger-subtle text-danger border border-danger">RETIRO</span>
                                            {% else %}
                                                <span class="badge bg-info-subtle text-info border border-info">{{ tx.type }}</span>
                                            {% endif %}
                                        </td>
                                        <td>{{ tx.description }}</td>
                                        <td class="text-end fw-bold {% if tx.type == 'DEPOSIT' %}text-success{% else %}text-danger{% endif %}">
                                            {% if tx.type == 'DEPOSIT' %}+{% else %}-{% endif %}${{ tx.amount|number_format(2, '.', ',') }}
                                        </td>
                                        <td class="text-center">
                                            <a href="{{ path('app_transaction_receipt', {id: tx.id}) }}" class="btn btn-sm btn-outline-secondary px-2" title="Ver Comprobante">
                                                <i class="bi bi-receipt"></i>
                                            </a>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">
                                            Esta cuenta aún no tiene movimientos registrados.
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card-footer bg-light d-flex justify-content-between align-items-center py-3">
                    <a href="{{ path('app_account_transactions', {id: account.id}) }}" class="btn btn-outline-primary btn-sm fw-bold">
                        <i class="bi bi-list-ul"></i> Ver todas las transacciones (Últimos 6 meses)
                    </a>

                    <button onclick="window.print();" class="btn btn-outline-secondary btn-sm fw-bold">
                        <i class="bi bi-printer-fill"></i> Imprimir
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}