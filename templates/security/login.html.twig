{% extends 'base.html.twig' %}

{% block title %}Iniciar Sesión - Caja de Ahorro{% endblock %}

{% block body %}
<div class="container mt-5" style="max-width: 450px;">
    {# Mensajes de notificación (ej. Confirmación de correo de recuperación enviado) #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show mb-3" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form method="post" action="{{ path('app_login') }}">
                {% if error %}
                    <div class="alert alert-danger mb-3">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                {% if app.user %}
                    <div class="alert alert-info mb-3">
                        Has iniciado sesión como <strong>{{ app.user.userIdentifier }}</strong>.
                        <div class="mt-2">
                            <a href="{{ path('app_logout') }}" class="btn btn-outline-danger btn-sm">Cerrar sesión</a>
                        </div>
                    </div>
                {% else %}
                    <div class="text-center mb-4">
                        <h1 class="h3 fw-bold text-dark mb-1">Por favor, ingresa</h1>
                        <p class="text-muted small">Ingresa tus credenciales para acceder al sistema</p>
                    </div>
                    
                    <div class="mb-3">
                        <label for="inputEmail" class="form-label fw-semibold">Correo electrónico</label>
                        <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus placeholder="ejemplo@correo.com">
                    </div>

                    <div class="mb-3">
                        <label for="inputPassword" class="form-label fw-semibold">Contraseña</label>
                        <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required placeholder="••••••••">
                    </div>

                    {# Token CSRF de Symfony #}
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    {# Casilla Recordarme y Enlace para Recuperar Contraseña #}
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="remember_me" name="_remember_me">
                            <label class="form-check-label small" for="remember_me">Recordarme</label>
                        </div>
                        <a href="{{ path('app_forgot_password_request') }}" class="text-decoration-none small text-primary fw-semibold">
                            ¿Olvidaste tu contraseña?
                        </a>
                    </div>

                    <button class="btn btn-primary w-100 py-2 fw-bold" type="submit">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar sesión
                    </button>
                {% endif %}
            </form>
        </div>
    </div>
</div>
{% endblock %}