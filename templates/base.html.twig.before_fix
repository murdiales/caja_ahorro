{% extends 'base.html.twig' %}

{% block title %}Detalle del Préstamo - {{ loan.number }}{% endblock %}

{% block body %}
<div class="container mt-4 mb-5">

    {# Header de la vista con datos clave del Socio y botones principales #}
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h2 class="h3 fw-bold mb-0 text-primary">
                    <i class="bi bi-bank me-2"></i>{{ loan.number }}
                </h2>
                <span class="badge bg-primary">
                    {{ loan.account.accountNumber }}
                </span>
            </div>
            <div class="mt-1">
                <span class="fw-bold fs-5 text-dark">
                    {{ loan.account.user.firstName }} {{ loan.account.user.lastName }}
                </span>
            </div>
        </div>

        <div class="d-flex gap-2 align-items-center">
            <a href="{{ path('loan_requests') }}" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>

            <button class="btn btn-outline-primary btn-sm">
                <i class="bi bi-file-earmark-pdf me-1"></i> PDF
            </button>

            {% if loan.status in ['SOLICITADO', 'SOLICITADO'] %}
                <form action="{{ path('loan_approve', {'id': loan.id}) }}" method="post" class="d-inline">
                    <button type="submit" class="btn btn-success btn-sm" onclick="return confirm('¿Desea aprobar este préstamo?');">
                        <i class="bi bi-check-lg me-1"></i> Aprobar
                    </button>
                </form>

                <form action="{{ path('loan_reject', {'id': loan.id}) }}" method="post" class="d-inline">
                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('¿Desea rechazar este préstamo?');">
                        <i class="bi bi-x-lg me-1"></i> Rechazar
                    </button>
                </form>
            {% endif %}
        </div>
    </div>

    {# Tarjetas de Resumen KPI #}
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-primary border-2 shadow-sm h-100">
                <div class="card-body text-center py-3">
                    <span class="text-muted small text-uppercase fw-bold">Monto</span>
                    <h3 class="text-primary fw-bold mb-0 mt-1">
                        ${{ loan.amount|number_format(2, '.', ',') }}
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-success border-2 shadow-sm h-100">
                <div class="card-body text-center py-3">
                    <span class="text-muted small text-uppercase fw-bold">Total a Pagar</span>
                    <h3 class="text-success fw-bold mb-0 mt-1">
                        ${{ loan.totalAmount|number_format(2, '.', ',') }}
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-warning border-2 shadow-sm h-100">
                <div class="card-body text-center py-3">
                    <span class="text-muted small text-uppercase fw-bold">Interés Total</span>
                    <h3 class="text-warning fw-bold mb-0 mt-1">
                        ${{ loan.totalInterest|number_format(2, '.', ',') }}
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-info border-2 shadow-sm h-100">
                <div class="card-body text-center py-3">
                    <span class="text-muted small text-uppercase fw-bold">Estado</span>
                    <div class="mt-2">
                        {% if loan.status in ['SOLICITADO', 'SOLICITADO'] %}
                            <span class="badge bg-warning text-dark px-3 py-2 fs-6">SOLICITADO</span>
                        {% elseif loan.status in ['APROBADO', 'APROBADO', 'ACTIVO', 'ACTIVO'] %}
                            <span class="badge bg-success px-3 py-2 fs-6">APROBADO</span>
                        {% elseif loan.status in ['DESEMBOLSADO', 'DISBURSED'] %}
                            <span class="badge bg-primary px-3 py-2 fs-6">DESEMBOLSADO</span>
                        {% elseif loan.status in ['RECHAZADO', 'RECHAZADO'] %}
                            <span class="badge bg-danger px-3 py-2 fs-6">RECHAZADO</span>
                        {% else %}
                            <span class="badge bg-primary px-3 py-2 fs-6">{{ loan.status }}</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Tarjeta Información del Socio #}
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h6 class="mb-0 fw-bold text-secondary">
                <i class="bi bi-person-badge me-1"></i> Información del Socio
            </h6>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12 col-md-3">
                    <span class="text-muted small d-block">Socio / Cliente</span>
                    <span class="fw-semibold fs-6 text-dark">
                        {{ loan.account.user.firstName }} {{ loan.account.user.lastName }}
                    </span>
                </div>

                <div class="col-12 col-md-3">
                    <span class="text-muted small d-block">Identificación / Cédula</span>
                    <span class="fw-semibold fs-6">
                        <code>{{ loan.account.user.identificationNumber }}</code>
                    </span>
                </div>

                <div class="col-12 col-md-3">
                    <span class="text-muted small d-block">Número de Cuenta</span>
                    <span class="fw-semibold fs-6 text-primary">
                        {{ loan.account.accountNumber }}
                    </span>
                </div>

                <div class="col-12 col-md-3">
                    <span class="text-muted small d-block">Saldo Actual</span>
                    <span class="badge bg-success fs-6">
                        ${{ loan.account.currentBalance|number_format(2, '.', ',') }}
                    </span>
                </div>
            </div>
        </div>
    </div>

    {# Tarjeta Información General del Préstamo #}
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h6 class="mb-0 fw-bold text-secondary">
                <i class="bi bi-info-circle me-1"></i> Información General
            </h6>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12 col-md-3">
                    <span class="text-muted small d-block">Fecha Solicitud</span>
                    <span class="fw-semibold fs-6">
                        {{ loan.requestDate|date('d/m/Y') }}
                    </span>
                </div>

                <div class="col-12 col-md-3">
                    <span class="text-muted small d-block">Plazo</span>
                    <span class="fw-semibold fs-6">
                        {{ loan.termMonths }} meses
                    </span>
                </div>

                <div class="col-12 col-md-3">
                    <span class="text-muted small d-block">Tasa de Interés</span>
                    <span class="fw-semibold fs-6">
                        {{ loan.interestRate }} %
                    </span>
                </div>

                <div class="col-12 col-md-3">
                    <span class="text-muted small d-block">Número de Préstamo</span>
                    <span class="fw-semibold fs-6">
                        {{ loan.number }}
                    </span>
                </div>

                {% if loan.approvalDate %}
                    <div class="col-12 col-md-4">
                        <span class="text-muted small d-block">Aprobado por</span>
                        <span class="fw-semibold text-success">
                            {{ loan.approvedBy }}
                        </span>
                    </div>

                    <div class="col-12 col-md-4">
                        <span class="text-muted small d-block">Fecha Aprobación</span>
                        <span class="fw-semibold text-success">
                            {{ loan.approvalDate|date('d/m/Y H:i') }}
                        </span>
                    </div>
                {% endif %}

                {% if loan.disbursementDate %}
                    <div class="col-12 col-md-4">
                        <span class="text-muted small d-block">Fecha Desembolso</span>
                        <span class="fw-semibold text-primary">
                            {{ loan.disbursementDate|date('d/m/Y H:i') }}
                        </span>
                    </div>
                {% endif %}

                {% if loan.rejectionDate %}
                    <div class="col-12">
                        <span class="text-muted small d-block">Motivo de Rechazo</span>
                        <div class="alert alert-danger mb-0 mt-1">
                            {{ loan.rejectionReason }}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    {# Tabla de Amortización #}
    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="card-header bg-white py-3">
            <h6 class="mb-0 fw-bold text-secondary">
                <i class="bi bi-table me-1"></i> Tabla de Amortización
            </h6>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="text-center py-2">#</th>
                        <th class="py-2">Vence</th>
                        <th class="text-end py-2">Saldo Inicial</th>
                        <th class="text-end py-2">Capital</th>
                        <th class="text-end py-2">Int.</th>
                        <th class="text-end py-2">Cuota</th>
                        <th class="text-end py-2">Saldo Fin.</th>
                        <th class="text-center py-2">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    {% for installment in installments %}
                        <tr>
                            <td class="text-center fw-bold">{{ installment.installmentNumber }}</td>
                            <td>{{ installment.dueDate|date('d/m/Y') }}</td>
                            <td class="text-end">${{ installment.openingBalance|number_format(2, '.', ',') }}</td>
                            <td class="text-end">${{ installment.principalAmount|number_format(2, '.', ',') }}</td>
                            <td class="text-end">${{ installment.interestAmount|number_format(2, '.', ',') }}</td>
                            <td class="text-end fw-bold text-primary">${{ installment.installmentAmount|number_format(2, '.', ',') }}</td>
                            <td class="text-end">${{ installment.closingBalance|number_format(2, '.', ',') }}</td>
                            <td class="text-center">
                                {% if installment.status in ['PENDIENTE', 'SOLICITADO'] %}
                                    <span class="badge bg-warning text-dark">PENDIENTE</span>
                                {% elseif installment.status in ['PAGADA', 'PAID'] %}
                                    <span class="badge bg-success">PAGADA</span>
                                {% elseif installment.status in ['VENCIDA', 'OVERDUE'] %}
                                    <span class="badge bg-danger">VENCIDA</span>
                                {% else %}
                                    <span class="badge bg-secondary">{{ installment.status }}</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                No hay cuotas registradas para este préstamo.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>
{% endblock %}
