{% extends 'base.html.twig' %}

{% block title %}Realizar Depósito{% endblock %}

{% block body %}
<div class="container mt-5" style="max-width: 650px;">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <div class="card shadow border-0">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0">💵 Depósito en Cuenta de Ahorro</h4>
        </div>
        <div class="card-body">
            <form method="post">
                {# Selección de Cuenta Destino (con preselección automática) #}
                <div class="mb-3">
                    <label for="account_id" class="form-label fw-bold">Seleccionar Cuenta Destino</label>
                    <select id="account_id" name="account_id" class="form-select" required>
                        <option value="" disabled {% if not selectedAccountId %}selected{% endif %}>-- Seleccione una cuenta --</option>
                        {% for acc in accounts %}
                            <option value="{{ acc.id }}" {% if selectedAccountId and selectedAccountId == acc.id %}selected{% endif %}>
                                {{ acc.accountNumber }} - {{ acc.user.firstName }} {{ acc.user.lastName }} (Saldo: ${{ acc.currentBalance|number_format(2, '.', ',') }})
                            </option>
                        {% else %}
                            <option value="" disabled>No hay cuentas registradas en el sistema</option>
                        {% endfor %}
                    </select>
                </div>

                {# Monto del Depósito #}
                <div class="mb-3">
                    <label for="amount" class="form-label fw-bold">
                        Monto a Depositar ($)
                    </label>

                    <input
                        type="number"
                        step="0.01"
                        min="0.01"
                        id="amount"
                        name="amount"
                        class="form-control"
                        placeholder="Ej. 100.00"
                        required
                    >
                </div>

                {# Fecha del Depósito #}
                <div class="mb-3">
                    <label for="transaction_date" class="form-label fw-bold">
                        Fecha del Depósito
                    </label>

                    <input
                        type="date"
                        id="transaction_date"
                        name="transaction_date"
                        class="form-control"
                        value="{{ 'now'|date('Y-m-d') }}"
                        required
                    >
                </div>

                {# Descripción / Motivo (Desplegable Estandarizado) #}
                <div class="mb-3">
                    <label for="description" class="form-label fw-bold">Descripción / Motivo</label>
                    <select id="description" name="description" class="form-select" required>
                        <option value="" disabled selected>-- Seleccione un motivo --</option>
                        {% for reason in reasons %}
                            <option value="{{ reason }}">{{ reason }}</option>
                        {% endfor %}
                    </select>
                </div>

<div id="loan-info" class="alert alert-info mt-3" style="display:none;">
    <h6 class="fw-bold mb-3">💳 Información del préstamo</h6>

    <div class="row">

        <div class="col-md-6">
            <strong>Préstamo:</strong><br>
            <span id="loan-number">Seleccione una cuenta</span>
        </div>

        <div class="col-md-6">
            <strong>Saldo pendiente:</strong><br>
            <span id="loan-balance">$0.00</span>
        </div>

    </div>

<div class="mt-3">
    <label class="form-label fw-bold">Préstamo</label>
    <select id="loan_id" name="loan_id" class="form-select">
        <option value="">Seleccione un préstamo</option>
    </select>
</div>


    <hr>

    <div class="row">

        <div class="col-md-6">
            <strong>Próxima cuota:</strong><br>
            <span id="loan-installment">$0.00</span>
        </div>

        <div class="col-md-6">
            <strong>Vencimiento:</strong><br>
            <span id="loan-date">--/--/----</span>
        </div>

    </div>

</div>

                <div class="d-flex justify-content-between pt-2">
                    <a href="{{ path('app_home') }}" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-success fw-bold">Confirmar Depósito</button>
                </div>
            </form>
        </div>
    </div>
<script>
document.addEventListener("DOMContentLoaded", function() {

    const reason = document.getElementById("description");
    const account = document.getElementById("account_id");
    const loanInfo = document.getElementById("loan-info");

    function toggleLoanInfo() {

        if (reason.value.startsWith("301")) {
            loanInfo.style.display = "block";
            loadLoanInfo();
        } else {
            loanInfo.style.display = "none";
        }
    }

    function loadLoanInfo() {

        if (!account.value) {
            return;
        }

        fetch("/transaction/deposit/loans/" + account.value)
            .then(response => response.json())
            .then(loans => {

                const loanSelect = document.getElementById("loan_id");

                loanSelect.innerHTML = "";

                const defaultOption = document.createElement("option");
                defaultOption.value = "";
                defaultOption.textContent = "Seleccione un préstamo";
                loanSelect.appendChild(defaultOption);

                loans.forEach(function(loan) {
                    const option = document.createElement("option");
                    option.value = loan.id;
                    option.textContent = loan.number;
                    loanSelect.appendChild(option);
                });


        fetch("/transaction/deposit/loan-info/" + account.value)
            .then(response => response.json())
            .then(data => {

                if (!data.success) {

                    document.getElementById("loan-number").innerText = "Sin préstamo activo";
                    document.getElementById("loan-balance").innerText = "$0.00";
                    document.getElementById("loan-installment").innerText = "$0.00";
                    document.getElementById("loan-date").innerText = "--/--/----";

                    return;
                }

                document.getElementById("loan-number").innerText = data.loan;
                document.getElementById("loan-balance").innerText = "$" + data.balance;
                document.getElementById("loan-installment").innerText = "$" + data.installment;
                document.getElementById("loan-date").innerText = data.dueDate;
            });
    }

    reason.addEventListener("change", toggleLoanInfo);
    account.addEventListener("change", loadLoanInfo);

    toggleLoanInfo();
});
</script>
</div>
{% endblock %}
