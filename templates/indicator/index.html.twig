{% extends 'base.html.twig' %}

{% block title %}Dashboard Ejecutivo - Panel Financiero{% endblock %}

{% block body %}
<style>
    /* Estilos para centrar y acotar el ancho del Dashboard */
    .dashboard-container {
        max-width: 1320px;
        margin: 0 auto;
    }

    .kpi-card {
        border: none;
        border-radius: 12px;
        color: #ffffff;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .kpi-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.12) !important;
    }
    .bg-gradient-purple {
        background: linear-gradient(135deg, #a855f7 0%, #6366f1 100%);
    }
    .bg-gradient-blue {
        background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
    }
    .bg-gradient-amber {
        background: linear-gradient(135deg, #f59e0b 0%, #ea580c 100%);
    }
    .bg-gradient-cyan {
        background: linear-gradient(135deg, #06b6d4 0%, #0284c7 100%);
    }
    .bg-gradient-rose {
        background: linear-gradient(135deg, #f43f5e 0%, #be123c 100%);
    }
    .bg-gradient-emerald {
        background: linear-gradient(135deg, #10b981 0%, #047857 100%);
    }
    .kpi-title {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        opacity: 0.9;
        font-weight: 600;
    }
    .kpi-value {
        font-size: 1.65rem;
        font-weight: 700;
    }
</style>

<div class="py-4" style="background-color: #f8fafc; min-height: 100vh;">
    {# Contenedor Principal Centrado #}
    <div class="container-fluid dashboard-container px-3 px-md-4">
        
        {# Encabezado Principal #}
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold text-dark mb-1">
                    <i class="bi bi-speedometer2 text-primary me-2"></i>Panel Financiero Ejecutivo
                </h3>
                <p class="text-muted small mb-0">Resumen operativo e indicadores clave de rendimiento</p>
            </div>
            <button class="btn btn-sm btn-white bg-white border shadow-sm rounded-pill px-3 fw-semibold text-secondary" onclick="window.location.reload();">
                <i class="bi bi-arrow-clockwise me-1"></i> Actualizar Datos
            </button>
        </div>

        {# Fila Superior: Tarjetas KPI Centradas y Acotadas #}
        <div class="row g-3 mb-4">
            {# Card 1: Socios Activos #}
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card kpi-card bg-gradient-purple shadow-sm h-100">
                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                        <div class="d-flex justify-content-between align-items-start">
                            <span class="kpi-title">Socios Activos</span>
                            <i class="bi bi-people-fill fs-4 opacity-75"></i>
                        </div>
                        <div class="mt-2">
                            <div class="kpi-value">{{ totalSocios }}</div>
                            <span class="small opacity-75"><i class="bi bi-check-circle me-1"></i>Registrados</span>
                        </div>
                    </div>
                </div>
            </div>

            {# Card 2: Ahorros Totales #}
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card kpi-card bg-gradient-emerald shadow-sm h-100">
                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                        <div class="d-flex justify-content-between align-items-start">
                            <span class="kpi-title">Total Ahorros</span>
                            <i class="bi bi-piggy-bank-fill fs-4 opacity-75"></i>
                        </div>
                        <div class="mt-2">
                            <div class="kpi-value">${{ totalAhorros|number_format(2, '.', ',') }}</div>
                            <span class="small opacity-75"><i class="bi bi-shield-check me-1"></i>En custodia</span>
                        </div>
                    </div>
                </div>
            </div>

            {# Card 3: Capital Prestado #}
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card kpi-card bg-gradient-amber shadow-sm h-100">
                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                        <div class="d-flex justify-content-between align-items-start">
                            <span class="kpi-title">Capital Prestado</span>
                            <i class="bi bi-bank fs-4 opacity-75"></i>
                        </div>
                        <div class="mt-2">
                            <div class="kpi-value">${{ montoPrestado|number_format(2, '.', ',') }}</div>
                            <span class="small opacity-75"><i class="bi bi-arrow-up-right me-1"></i>Colocación</span>
                        </div>
                    </div>
                </div>
            </div>

            {# Card 4: Liquidez Disponible #}
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card kpi-card {% if liquidez >= 0 %}bg-gradient-blue{% else %}bg-gradient-rose{% endif %} shadow-sm h-100">
                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                        <div class="d-flex justify-content-between align-items-start">
                            <span class="kpi-title">Liquidez</span>
                            <i class="bi bi-wallet2 fs-4 opacity-75"></i>
                        </div>
                        <div class="mt-2">
                            <div class="kpi-value">${{ liquidez|number_format(2, '.', ',') }}</div>
                            <span class="small opacity-75">
                                {% if liquidez >= 0 %}
                                    <i class="bi bi-check-lg me-1"></i>Positiva
                                {% else %}
                                    <i class="bi bi-exclamation-triangle me-1"></i>Déficit
                                {% endif %}
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            {# Card 5: Depósitos Totales #}
            <div class="col-12 col-sm-6 col-xl-4">
                <div class="card kpi-card bg-gradient-cyan shadow-sm h-100">
                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                        <div class="d-flex justify-content-between align-items-start">
                            <span class="kpi-title">Depósitos Totales</span>
                            <i class="bi bi-cash-stack fs-4 opacity-75"></i>
                        </div>
                        <div class="mt-2">
                            <div class="kpi-value">${{ totalDepositos|number_format(2, '.', ',') }}</div>
                            <span class="small opacity-75">Ingresos acumulados</span>
                        </div>
                    </div>
                </div>
            </div>

            {# Card 6: Cuotas Vencidas #}
            <div class="col-12 col-sm-6 col-xl-4">
                <div class="card kpi-card bg-gradient-rose shadow-sm h-100">
                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                        <div class="d-flex justify-content-between align-items-start">
                            <span class="kpi-title">Cuotas Vencidas</span>
                            <i class="bi bi-exclamation-circle-fill fs-4 opacity-75"></i>
                        </div>
                        <div class="mt-2">
                            <div class="kpi-value">{{ cuotasVencidas }}</div>
                            <span class="small opacity-75">Pendientes de cobro</span>
                        </div>
                    </div>
                </div>
            </div>

            {# Card 7: Índice de Morosidad % #}
            <div class="col-12 col-sm-6 col-xl-4">
                <div class="card kpi-card bg-gradient-rose shadow-sm h-100">
                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                        <div class="d-flex justify-content-between align-items-start">
                            <span class="kpi-title">Índice de Morosidad</span>
                            <i class="bi bi-percent fs-4 opacity-75"></i>
                        </div>
                        <div class="mt-2">
                            <div class="kpi-value">{{ morosidad|number_format(2, '.', ',') }}%</div>
                            <span class="small opacity-75">Cartera en riesgo</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Gráfico Principal: Evolución Mensual #}
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white py-3 border-0 d-flex align-items-center justify-content-between">
                <h6 class="fw-bold text-dark mb-0">
                    <i class="bi bi-graph-up-arrow text-primary me-2"></i>Evolución Mensual de Depósitos
                </h6>
                <span class="badge bg-light text-secondary border">Año corrido</span>
            </div>
            <div class="card-body">
                <div style="height: 280px;">
                    <canvas id="evolucionMensual"></canvas>
                </div>
            </div>
        </div>

        {# Gráficos Comparativos Secundarios #}
        <div class="row g-4 mb-4">
            {# Gráfico 2: Depósitos vs Retiros #}
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white py-3 border-0">
                        <h6 class="fw-bold text-dark mb-0">
                            <i class="bi bi-bar-chart-line text-emerald me-2"></i>Depósitos vs Retiros
                        </h6>
                    </div>
                    <div class="card-body">
                        <div style="height: 250px;">
                            <canvas id="depositosRetiros"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            {# Gráfico 3: Estado de Préstamos (Dona) #}
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white py-3 border-0">
                        <h6 class="fw-bold text-dark mb-0">
                            <i class="bi bi-pie-chart text-indigo me-2"></i>Estado de Préstamos
                        </h6>
                    </div>
                    <div class="card-body">
                        <div style="height: 250px;">
                            <canvas id="estadoPrestamos"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Alertas Gerenciales #}
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white py-3 border-0 d-flex align-items-center justify-content-between">
                <h6 class="fw-bold text-dark mb-0">
                    <i class="bi bi-shield-exclamation text-danger me-2"></i>Alertas Gerenciales
                </h6>
                {% if alertas is not empty %}
                    <span class="badge bg-danger rounded-pill px-3">{{ alertas|length }} Críticas</span>
                {% endif %}
            </div>
            <div class="card-body pt-0">
                {% if alertas is empty %}
                    <div class="alert alert-success border-0 bg-success bg-opacity-10 text-success mb-0 rounded-3">
                        <i class="bi bi-check-circle-fill me-2"></i>No existen alertas críticas registradas.
                    </div>
                {% else %}
                    <div class="list-group list-group-flush">
                        {% for alerta in alertas %}
                            <div class="list-group-item px-0 py-2 border-0 d-flex align-items-center">
                                <i class="bi bi-exclamation-triangle-fill text-warning me-3 fs-5"></i>
                                <span class="fw-medium text-dark">{{ alerta }}</span>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>

    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function () {
    // 1. Gráfico de Línea con gradiente suave
    const ctxEvolucion = document.getElementById('evolucionMensual').getContext('2d');
    const gradient = ctxEvolucion.createLinearGradient(0, 0, 0, 260);
    gradient.addColorStop(0, 'rgba(99, 102, 241, 0.35)');
    gradient.addColorStop(1, 'rgba(99, 102, 241, 0.0)');

    new Chart(ctxEvolucion, {
        type: 'line',
        data: {
            labels: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun'],
            datasets: [{
                label: 'Depósitos ($)',
                data: [5000, 7500, 11000, 9000, 14500, 18000],
                borderColor: '#6366f1',
                borderWidth: 3,
                backgroundColor: gradient,
                fill: true,
                tension: 0.4,
                pointBackgroundColor: '#6366f1',
                pointRadius: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: {
                    grid: { color: 'rgba(0,0,0,0.04)' },
                    ticks: { callback: function(value) { return '$' + value.toLocaleString(); } }
                },
                x: { grid: { display: false } }
            }
        }
    });

    // 2. Gráfico de Barras: Depósitos vs Retiros
    const ctx2 = document.getElementById('depositosRetiros');
    new Chart(ctx2, {
        type: 'bar',
        data: {
            labels: ['Depósitos', 'Retiros'],
            datasets: [{
                label: 'Monto ($)',
                data: [
                    {{ depositosGrafico|default(0) }},
                    {{ retirosGrafico|default(0) }}
                ],
                backgroundColor: ['#10b981', '#f43f5e'],
                borderRadius: 8,
                maxBarThickness: 38
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: {
                    grid: { color: 'rgba(0,0,0,0.04)' },
                    ticks: { callback: function(value) { return '$' + value.toLocaleString(); } }
                },
                x: { grid: { display: false } }
            }
        }
    });

    // 3. Gráfico de Dona: Estado de Préstamos
    const ctx3 = document.getElementById('estadoPrestamos');
    new Chart(ctx3, {
        type: 'doughnut',
        data: {
            labels: ['Activos', 'Pagados', 'Vencidos'],
            datasets: [{
                data: [
                    {{ estadoPrestamos.activos|default(0) }},
                    {{ estadoPrestamos.cerrados|default(0) }},
                    {{ estadoPrestamos.vencidos|default(0) }}
                ],
                backgroundColor: ['#10b981', '#3b82f6', '#f43f5e'],
                borderWidth: 3,
                borderColor: '#ffffff'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '70%',
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: { padding: 12, usePointStyle: true }
                }
            }
        }
    });
});
</script>
{% endblock %}
