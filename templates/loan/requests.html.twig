{% extends 'base.html.twig' %}

{% block title %}Solicitudes de Préstamos{% endblock %}

{% block body %}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0">Solicitudes de Préstamos</h2>
            <small class="text-muted">Administración de solicitudes de préstamos</small>
        </div>

        <div>
            <a href="{{ path('loan_simulator') }}" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle me-1"></i> Nueva Solicitud
            </a>
        </div>
    </div>

    {# Tarjetas de Resumen KPI #}
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row text-center">
                <div class="col-md-3">
                    <h6 class="text-muted">Total Solicitudes</h6>
                    <h3 class="text-primary fw-bold">{{ loans|length }}</h3>
                </div>

                <div class="col-md-3">
                    <h6 class="text-muted">Solicitadas</h6>
                    <h3 class="text-warning fw-bold">
                        {{ loans|filter(l => l.status in ['SOLICITADO', 'SOLICITADO'])|length }}
                    </h3>
                </div>

                <div class="col-md-3">
                    <h6 class="text-muted">Activas / Aprobadas</h6>
                    <h3 class="text-success fw-bold">
                        {{ loans|filter(l => l.status in ['ACTIVO', 'APROBADO', 'APROBADO', 'ACTIVO'])|length }}
                    </h3>
                </div>

                <div class="col-md-3">
                    <h6 class="text-muted">Canceladas / Rechazadas</h6>
                    <h3 class="text-secondary fw-bold">
                        {{ loans|filter(l => l.status in ['CANCELADO', 'RECHAZADO', 'RECHAZADO'])|length }}
                    </h3>
                </div>
            </div>
        </div>
    </div>

    {# Listado de Solicitudes #}
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Número</th>
                            <th class="text-end">Monto</th>
                            <th>Plazo</th>
                            <th>Interés</th>
                            <th class="text-end">Total</th>
                            <th>Estado</th>
                            <th>Solicitud</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for loan in loans %}
                        <tr>
                            <td>
                                <strong>{{ loan.number }}</strong>
                            </td>

                            <td class="text-end">
                                ${{ loan.amount|number_format(2, '.', ',') }}
                            </td>

                            <td>
                                {{ loan.termMonths }} meses
                            </td>

                            <td>
                                {{ loan.interestRate }} %
                            </td>

                            <td class="text-end">
                                ${{ loan.totalAmount|number_format(2, '.', ',') }}
                            </td>

                            <td>
                                {% if loan.status in ['SOLICITADO', 'SOLICITADO'] %}
                                    <span class="badge bg-warning text-dark">SOLICITADO</span>
                                {% elseif loan.status in ['ACTIVO', 'APROBADO', 'APROBADO', 'ACTIVO'] %}
                                    <span class="badge bg-success">APROBADO</span>
                                {% elseif loan.status in ['DESEMBOLSADO', 'DISBURSED'] %}
                                    <span class="badge bg-primary">DESEMBOLSADO</span>
                                {% elseif loan.status in ['CANCELADO', 'RECHAZADO', 'RECHAZADO'] %}
                                    <span class="badge bg-secondary">{{ loan.status }}</span>
                                {% else %}
                                    <span class="badge bg-info text-dark">{{ loan.status }}</span>
                                {% endif %}
                            </td>

                            <td>
                                {{ loan.requestDate|date('d/m/Y') }}
                            </td>

                            <td class="text-center">
                                <a href="{{ path('loan_detail', {'id': loan.id}) }}" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye me-1"></i> Ver
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="text-center py-4">
                                <span class="text-muted">No existen solicitudes registradas.</span>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

{% endblock %}
