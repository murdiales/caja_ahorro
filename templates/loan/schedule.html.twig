{% extends 'base.html.twig' %}

{% block title %}Tabla de Amortización{% endblock %}

{% block body %}

<div class="container mt-4">

    <div class="card shadow-sm border-0">

        <div class="card-header bg-success text-white">
            <h3 class="mb-0">
                📄 Tabla de Amortización
            </h3>
        </div>

        <div class="card-body">

            <h5 class="mb-4">
                {{ loan.number }}
            </h5>

            <div class="table-responsive">

                <table class="table table-striped table-hover">

                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Vencimiento</th>
                            <th>Capital</th>
                            <th>Interés</th>
                            <th>Cuota</th>
                            <th>Estado</th>
                        </tr>
                    </thead>

                    <tbody>

                    {% for installment in installments %}

                        <tr>

                            <td>
                                {{ installment.installmentNumber }}
                            </td>

                            <td>
                                {{ installment.dueDate|date('d/m/Y') }}
                            </td>

                            <td>
                                ${{ installment.principalAmount|number_format(2) }}
                            </td>

                            <td>
                                ${{ installment.interestAmount|number_format(2) }}
                            </td>

                            <td>
                                <strong>
                                    ${{ installment.installmentAmount|number_format(2) }}
                                </strong>
                            </td>

                            <td>

                                {% if installment.status == 'PAGADO' %}
                                    <span class="badge bg-success">
                                        PAGADO
                                    </span>
                                {% else %}
                                    <span class="badge bg-warning text-dark">
                                        PENDIENTE
                                    </span>
                                {% endif %}

                            </td>

                        </tr>

                    {% endfor %}

                    </tbody>

                </table>

            </div>

            <div class="text-center mt-4">

                <a href="/loan/loan/{{ loan.id }}"
                   class="btn btn-primary me-2">
                   📋 Ver Préstamo
                </a>

                <a href="/loan/history"
                   class="btn btn-secondary">
                   ↩ Volver al Historial
                </a>

            </div>
            </div>

        </div>

    </div>

</div>

{% endblock %}
