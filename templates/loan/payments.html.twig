{% extends 'base.html.twig' %}

{% block title %}Control de Pagos e Intereses{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold text-primary mb-0">💵 Control de Pagos de Préstamos e Intereses</h3>
        <button onclick="window.print();" class="btn btn-outline-secondary btn-sm fw-bold">
            <i class="bi bi-printer-fill"></i> Imprimir Reporte
        </button>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Nº Préstamo</th>
                            <th>Socio</th>
                            <th>Monto Original</th>
                            <th>Tasa Interés</th>
                            <th>Cuota Mensual</th>
                            <th>Estado</th>
                            <th>Aprobado El</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for loan in loans %}
                            <tr>
                                <td><code>#{{ loan.id }}</code></td>
                                <td class="fw-bold">{{ loan.account.user.firstName }} {{ loan.account.user.lastName }}</td>
                                <td class="fw-bold text-success">${{ loan.amount|number_format(2, '.', ',') }}</td>
                                <td><span class="badge bg-secondary">{{ loan.interestRate }}% Anual</span></td>
                                <td><strong>${{ loan.monthlyFee|number_format(2, '.', ',') }}</strong> /mes</td>
                                <td><span class="badge bg-success">ACTIVO / APROBADO</span></td>
                                <td class="small">{{ loan.approvedAt ? loan.approvedAt|date('d/m/Y H:i') : 'N/A' }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    No hay préstamos activos registrados en el sistema.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}