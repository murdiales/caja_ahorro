{% extends 'base.html.twig' %}

{% block title %}Control de Pagos e Intereses{% endblock %}

{% block body %}
<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-primary mb-0">
                Control de Pagos de Préstamos
            </h3>
            <small class="text-muted">
                Listado y control general de los pagos e intereses de los préstamos
            </small>
        </div>

        <button onclick="window.print();" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-printer-fill me-1"></i>
            Imprimir Reporte
        </button>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card border-primary shadow-sm">
            <div class="card-body text-center">
                <small class="text-muted">Préstamos</small>
                <h3 class="mb-0">{{ totalLoans }}</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-success shadow-sm">
            <div class="card-body text-center">
                <small class="text-muted">Monto Prestado</small>
                <h3 class="mb-0">$ {{ totalAmount|number_format(2, '.', ',') }}</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-warning shadow-sm">
            <div class="card-body text-center">
                <small class="text-muted">Interés Total</small>
                <h3 class="mb-0">$ {{ totalInterest|number_format(2, '.', ',') }}</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-info shadow-sm">
            <div class="card-body text-center">
                <small class="text-muted">Período</small>
<h3 class="mb-0">{% if period == '3m' %}3 Meses{% elseif period == '6m' %}6 Meses{% elseif period == '1y' %}1 Año{% else %}Todos{% endif %}</h3>
            </div>
        </div>
    </div>
</div>
<div class="mb-3 d-flex gap-2">
<a href="?period=3m" class="btn btn-outline-primary btn-sm">Últimos 3 meses</a>
<a href="?period=6m" class="btn btn-outline-primary btn-sm">Últimos 6 meses</a>
<a href="?period=1y" class="btn btn-outline-primary btn-sm">Último año</a>
<a href="?period=all" class="btn btn-outline-secondary btn-sm">Todos</a>
</div>
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark text-center">
                        <tr class="align-middle">
                            <th>Nº Préstamo</th>
                            <th>Socio</th>
                            <th class="text-end">Monto Original</th>
                            <th class="text-center">Tasa Interés</th>
                            <th class="text-end">Cuota Mensual</th>
                            <th class="text-center">Estado</th>
                            <th>Aprobado El</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                    {% for loan in loans %}
                        <tr>

                            <td>
                                <span class="badge bg-light text-danger border fs-6">#{{ loan.number ?: loan.id }}</span>
                            </td>

<td>
    {% if loan.account and loan.account.user %}
        <div class="d-flex align-items-center">
            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-2" style="width:36px;height:36px;font-size:14px;">
                {{ loan.account.user.firstName|first|upper }}
            </div>
            <div>
                <div class="fw-bold">
                    {{ loan.account.user.firstName }} {{ loan.account.user.lastName }}
                </div>
                <small class="text-muted">Socio activo</small>
            </div>
        </div>
    {% else %}
        <span class="text-muted">Sin socio</span>
    {% endif %}
</td>

                            <td class="text-end fw-bold text-success">
                                ${{ loan.amount|number_format(2, '.', ',') }}
                            </td>

                            <td class="text-center">
                                <span class="badge rounded-pill bg-primary">
                                    {{ loan.interestRate }}%
                                </span>
                            </td>

                            <td class="text-end">

                                {% if loan.termMonths > 0 and loan.totalAmount %}
                                    <strong>
                                        ${{ (loan.totalAmount / loan.termMonths)|number_format(2, '.', ',') }}
                                    </strong>
                                {% else %}
                                    <span class="text-muted">
                                        N/A
                                    </span>
                                {% endif %}

                            </td>

                            <td class="text-center">

                                {% if loan.status == 'APROBADO' %}
                                    <span class="badge rounded-pill bg-success px-3">
                                        APROBADO
                                    </span>

                                {% elseif loan.status == 'SOLICITADO' %}
                                    <span class="badge rounded-pill bg-warning text-dark px-3">
                                        SOLICITADO
                                    </span>

                                {% elseif loan.status == 'DESEMBOLSADO' %}
                                    <span class="badge bg-primary">
                                        DESEMBOLSADO
                                    </span>

                                {% elseif loan.status == 'RECHAZADO' %}
                                    <span class="badge bg-danger">
                                        RECHAZADO
                                    </span>

                                {% else %}
                                    <span class="badge rounded-pill bg-primary">
                                        {{ loan.status }}
                                    </span>
                                {% endif %}

                            </td>

                            <td>
                                {% if loan.approvalDate %}
                                    {{ loan.approvalDate|date('d/m/Y H:i') }}
                                {% else %}
                                    N/A
                                {% endif %}
                            </td>
<td class="text-center">

    <a href="{{ path('loan_schedule', {'id': loan.id}) }}"
       class="btn btn-sm btn-outline-secondary"
       title="Cuotas y amortización">
        <i class="bi bi-calendar-check"></i>
    </a>

    <a href="{{ path('loan_pay', {'id': loan.id}) }}"
       class="btn btn-sm btn-outline-success"
       title="Gestión de pagos">
        <i class="bi bi-cash-coin"></i>
    </a>
</td>
</tr>

</td>

                        </tr>

                    {% else %}

                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                No hay préstamos registrados en el sistema.
                            </td>
                        </tr>

                    {% endfor %}
                    </tbody>

                </table>

            </div>
        </div>
    </div>

</div>
{% endblock %}
