{% extends 'base.html.twig' %}

{% block title %}Simulador de Préstamos{% endblock %}

{% block body %}
<div class="container mt-4 mb-5">

    <div class="d-flex align-items-center mb-2">
        <i class="bi bi-cash-stack fs-2 text-primary me-2"></i>
        <h1 class="h2 mb-0 fw-bold">Simulador de Préstamos</h1>
    </div>
    <p class="text-muted mb-4">
        Calcule cuotas, intereses y tabla de amortización antes de solicitar un préstamo.
    </p>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            {{ form_start(form) }}

                <div class="row g-3">
                    <div class="col-12 col-sm-6 col-lg-3">
                        {{ form_label(form.amount, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.amount, {'attr': {'class': 'form-control', 'placeholder': 'Ej. 1000'}}) }}
                        {{ form_errors(form.amount) }}
                    </div>

                    <div class="col-12 col-sm-6 col-lg-3">
                        {{ form_label(form.termMonths, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.termMonths, {'attr': {'class': 'form-control', 'placeholder': 'Ej. 12'}}) }}
                        {{ form_errors(form.termMonths) }}
                    </div>

                    <div class="col-12 col-sm-6 col-lg-3">
                        {{ form_label(form.interestRate, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.interestRate, {'attr': {'class': 'form-control', 'placeholder': 'Ej. 1.5'}}) }}
                        {{ form_errors(form.interestRate) }}
                    </div>

                    <div class="col-12 col-sm-6 col-lg-3">
                        {{ form_label(form.firstDueDate, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.firstDueDate, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.firstDueDate) }}
                    </div>
                </div>

                <div class="mt-4 text-end">
                    <button class="btn btn-primary btn-lg w-100 w-md-auto px-4">
                        <i class="bi bi-calculator me-1"></i> Calcular Préstamo
                    </button>
                </div>

            {{ form_end(form) }}
        </div>
    </div>

    {% if result %}
        <hr class="my-5">

        <h3 class="h4 fw-bold mb-3">Resultado de la Simulación</h3>

        <div class="row g-3 mb-4">
            <div class="col-12 col-md-4">
                <div class="card border-primary border-2 shadow-sm h-100">
                    <div class="card-body text-center py-3">
                        <span class="text-muted text-uppercase small fw-bold">Capital Mensual</span>
                        <h3 class="text-primary fw-bold mb-0 mt-1">
                            ${{ result.capitalMonthly|number_format(2, '.', ',') }}
                        </h3>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="card border-success border-2 shadow-sm h-100">
                    <div class="card-body text-center py-3">
                        <span class="text-muted text-uppercase small fw-bold">Interés Total</span>
                        <h3 class="text-success fw-bold mb-0 mt-1">
                            ${{ result.totalInterest|number_format(2, '.', ',') }}
                        </h3>
                    </div>
                </div>
            </div>

            <div class="col-12 col-md-4">
                <div class="card border-warning border-2 shadow-sm h-100">
                    <div class="card-body text-center py-3">
                        <span class="text-muted text-uppercase small fw-bold">Total a Pagar</span>
                        <h3 class="text-warning fw-bold mb-0 mt-1">
                            ${{ result.totalPayment|number_format(2, '.', ',') }}
                        </h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm overflow-hidden mb-4">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="text-center py-3">Cuota</th>
                            <th class="text-end py-3">Saldo Inicial</th>
                            <th class="text-end py-3">Capital</th>
                            <th class="text-end py-3">Interés</th>
                            <th class="text-end py-3">Total</th>
                            <th class="text-end py-3">Saldo Final</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in result.installments %}
                            <tr>
                                <td class="text-center fw-bold">{{ item.installment }}</td>
                                <td class="text-end">${{ item.opening_balance|number_format(2, '.', ',') }}</td>
                                <td class="text-end">${{ item.principal|number_format(2, '.', ',') }}</td>
                                <td class="text-end">${{ item.interest|number_format(2, '.', ',') }}</td>
                                <td class="text-end fw-bold text-primary">${{ item.payment|number_format(2, '.', ',') }}</td>
                                <td class="text-end">${{ item.closing_balance|number_format(2, '.', ',') }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <form action="{{ path('loan_create') }}" method="post">
            <input
                type="hidden"
                name="amount"
                value="{{ form.amount.vars.value }}"
            >

            <input
                type="hidden"
                name="termMonths"
                value="{{ form.termMonths.vars.value }}"
            >

            <input
                type="hidden"
                name="interestRate"
                value="{{ form.interestRate.vars.value }}"
            >

            <input
                type="hidden"
                name="firstDueDate"
                value="{{ form.firstDueDate.vars.value }}"
            >

            <div class="text-end mt-3">
                <button
                    type="submit"
                    class="btn btn-success btn-lg"
                >
                    <i class="bi bi-check-circle me-1"></i> Solicitar Préstamo
                </button>
            </div>
        </form>
    {% endif %}

</div>
{% endblock %}
