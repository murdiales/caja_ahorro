{% extends 'base.html.twig' %}

{% block title %}Historial de Préstamos{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold text-primary mb-0">📜 Historial General de Préstamos</h3>
        <button onclick="window.print();" class="btn btn-outline-secondary btn-sm fw-bold">
            <i class="bi bi-printer-fill"></i> Imprimir
        </button>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Nº</th>
                            <th>Cuenta</th>
                            <th>Socio</th>
                            <th>Monto</th>
                            <th>Plazo</th>
                            <th>Estado</th>
                            <th>Fecha Solicitud</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for loan in loans %}
                            <tr>
                                <td><code>#{{ loan.id }}</code></td>
                                <td><span class="badge bg-primary">{{ loan.account.accountNumber }}</span></td>
                                <td class="fw-bold">{{ loan.account.user.firstName }} {{ loan.account.user.lastName }}</td>
                                <td class="fw-bold">${{ loan.amount|number_format(2, '.', ',') }}</td>
                                <td>{{ loan.termMonths }} Meses</td>
                                <td>
                                    {% if loan.status == 'PENDING' %}
                                        <span class="badge bg-warning text-dark">PENDIENTE</span>
                                    {% elseif loan.status == 'APPROVED' %}
                                        <span class="badge bg-success">APROBADO</span>
                                    {% else %}
                                        <span class="badge bg-secondary">{{ loan.status }}</span>
                                    {% endif %}
                                </td>
                                <td class="small">{{ loan.requestedAt|date('d/m/Y H:i') }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    No hay préstamos registrados.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}