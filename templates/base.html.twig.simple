<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Caja de Ahorro{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🏦</text></svg>">
        
        {# Bootstrap 5 CSS CDN #}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        {# Bootstrap Icons #}
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        
        {% block stylesheets %}{% endblock %}
    </head>
    <body class="bg-light">

        {% if app.user %}
        {# Navbar Menú Principal #}
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold text-success" href="{{ path('app_home') }}">
                    🏦 Caja de Ahorro
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        {# Inicio #}
                        <li class="nav-item">
                            <a class="nav-link active" href="{{ path('app_home') }}">
                                <i class="bi bi-house-door-fill"></i> Ventanilla

                        {% if is_granted('ROLE_ADMIN') %}
                        {# Módulo 1: Administración de Cuentas #}
                        <li class="nav-item dropdown">

    <a class="nav-link dropdown-toggle"
       href="#"
       role="button"
       data-bs-toggle="dropdown">
 

        <li>
            <h6 class="dropdown-header">
                Gestión de Usuarios
            </h6>
        </li>

        <li>
            <a class="dropdown-item"
               href="{{ path('app_usercess"></i>
                Crear Usuario
            </a>
        </li>

        <li>
             }}">
                <i class="bi bi-person-lines-fill text-primary"></i>
                Listar / Editar Usuarios
            </a>
        </li>

        <li><hr class="dropdown-divider"></li>

        <li>
            <h6 class="dropdown-header">
                Gestión de Cuentas
            </h6>
        </li>

        <li>
            /admin?crudAction=new&crudControllerFqcn=App%5CController%5CAdmin%5CAccountCrudController
                <i class="bi bi-card-heading text-warning"></i>
                Crear Cuenta de Ahorro
            </a>
        </li>

        <li>
             }}">
                <i class="bi bi-percent text-warning"></i>
                Tasas de Interés
            </a>
        </li>

    </ul>

</li>
{% endif %}


                        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_TESORERO') %}
                        {# Módulo 2: Transacciones #}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-cash-stack"></i> Transacciones
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="{{ path('app_transaction_deposit') }}"><i class="bi bi-arrow-down-left-circle-fill text-success"></i> Depósito</a></li>
                                <li><a class="dropdown-item" href="{{ path('app_transaction_withdraw') }}"><i class="bi bi-arrow-up-right-circle-fill text-warning"></i> Retiro</a></li>
                                <li><a class="dropdown-item disabled" href="#"><i class="bi bi-arrow-left-right text-info"></i> Transferencia Inter-Cuentas</a></li>
                            </ul>
                        </li>
                        {% endif %}

                        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_TESORERO') %}
                        {# Módulo 3: Préstamos #}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-bank"></i> Préstamos
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="{{ path('app_loan_request') }}"><i class="bi bi-file-earmark-plus text-success"></i> Nueva Solicitud</a></li>
                                <li><a class="dropdown-item" href="{{ path('app_loan_pending') }}"><i class="bi bi-clock-history text-warning"></i> Solicitudes y Aprobaciones</a></li>
                                <li><a class="dropdown-item" href="{{ path('app_loan_payments') }}"><i class="bi bi-calculator text-primary"></i> Control de Pagos e Intereses</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="{{ path('app_loan_history') }}"><i class="bi bi-journal-text"></i> Historial General</a></li>
                            </ul>
                        </li>
                        {% endif %}

                        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_TESORERO') %}
                        {# Módulo 4: Informes Financieros #}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-file-earmark-bar-graph-fill"></i> Informes Financieros
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="{{ path('app_interest_rate_index') }}"><i class="bi bi-percent text-warning"></i> Configuración de Tasas de Interés</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item disabled" href="#"><i class="bi bi-journal-text"></i> Estado de Cuenta General</a></li>
                                <li><a class="dropdown-item disabled" href="#"><i class="bi bi-receipt"></i> Historial de Transacciones</a></li>
                                <li><a class="dropdown-item disabled" href="#"><i class="bi bi-pie-chart-fill"></i> Balance de Caja</a></li>
                            </ul>
                        </li>
                        {% endif %}

                        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_SECRETARIO') %}
                        {# Módulo 5: Gestión Documental e Historial de Correos #}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-folder-symlink-fill"></i> Gestión Documental
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="{{ path('app_document_index') }}"><i class="bi bi-file-earmark-pdf-fill text-danger"></i> Documentos Institucionales (Actas, Reglamentos)</a></li>
                                <li><a class="dropdown-item" href="{{ path('app_email_log_index') }}"><i class="bi bi-mailbox text-primary"></i> Correos Enviados</a></li>
                                <li><a class="dropdown-item" href="{{ path('app_public_portal') }}" target="_blank"><i class="bi bi-globe text-info"></i> Ver Portal Web Público</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item disabled" href="#"><i class="bi bi-file-earmark-check-fill text-success"></i> Comprobantes de Depósito/Retiro</a></li>
                                <li><a class="dropdown-item disabled" href="#"><i class="bi bi-file-earmark-word-fill text-primary"></i> Contratos de Apertura de Cuenta</a></li>
                                <li><a class="dropdown-item disabled" href="#"><i class="bi bi-archive-fill"></i> Archivo Digital de Socios</a></li>
                            </ul>
                        </li>
                        {% endif %}

                        {# Inicio #}
                        <li class="nav-item">
                            {{ path('app_home') }}
                                <i class="bi bi-house-door-fill"></i> Ventanilla
                            </a>
                        </li>

                        {% if app.user %}
                        <li class="nav-item">
                             }}">
                                <i class="bi bi-journal-text"></i> Documentos Institucionales
                            </a>
                        </li>
                        {% endif %}

                        {% if is_granted('ROLE_ADMIN') %}
                        {# Módulo 1: Administración de Cuentas #}
                        <li class="nav-item dropdown">

                        {% if is_granted('ROLE_ADMIN') %}
                        {# Opción directa para Configurar el Sitio Web #}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_site_config_index') }}">
                                <i class="bi bi-sliders"></i> Config. Portal Web
                            </a>
                        </li>
                    </ul>
                    {% endif %}
                    {% endif %}

                    {# Usuario activo y Logout #}
                    <div class="d-flex align-items-center gap-3">
                        <span class="navbar-text text-light small">
                            <i class="bi bi-person-circle"></i> {{ app.user.firstName }} {{ app.user.lastName }}
                        </span>
                        <a href="{{ path('app_logout') }}" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-box-arrow-right"></i> Salir
                        </a>
                    </div>
                </div>
            </div>
        </nav>
        {% endif %}

        <main class="py-4">
            {% block body %}{% endblock %}
        </main>

        {# Bootstrap 5 JS CDN #}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>
