<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ configs['site_title'] ?? 'Caja de Ahorro Familiar' }}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>

    {# Navegación Pública #}
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold text-success d-flex align-items-center gap-2" href="#">
                {% if configs['logo'] is defined and configs['logo'] %}
                    <img src="{{ asset('uploads/site/' ~ configs['logo']) }}" alt="Logo" height="36">
                {% else %}
                    🏦
                {% endif %}
                {{ configs['site_title'] ?? 'Caja de Ahorro Familiar' }}
            </a>
            <div class="ms-auto">
                {% if app.user %}
                    <a href="{{ path('app_home') }}" class="btn btn-success btn-sm fw-bold">Ir a Ventanilla</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-outline-light btn-sm fw-bold">Iniciar Sesión</a>
                {% endif %}
            </div>
        </div>
    </nav>

    {# Seccion Hero / Banner #}
    <section class="py-5 text-center bg-light border-bottom position-relative overflow-hidden">
        {% if configs['hero_banner'] is defined and configs['hero_banner'] %}
            <div class="mb-4">
                <img src="{{ asset('uploads/site/' ~ configs['hero_banner']) }}" class="img-fluid rounded shadow" style="max-height: 350px; width: 80%; object-fit: cover;">
            </div>
        {% endif %}
        <div class="container py-3">
            <h1 class="display-4 fw-bold text-dark">{{ configs['site_title'] ?? 'Caja de Ahorro Familiar' }}</h1>
            <p class="lead text-muted col-md-8 mx-auto">{{ configs['hero_subtitle'] ?? 'Fomentando la cultura del ahorro y apoyo mutuo.' }}</p>
        </div>
    </section>

    {# Sección Sobre Nosotros #}
    <section class="py-5">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-8 mx-auto text-center">
                    <h2 class="fw-bold text-primary mb-3">Nuestra Institución</h2>
                    <p class="fs-5 text-secondary" style="white-space: pre-line;">{{ configs['about_us_text'] ?? 'Bienvenidos a nuestro portal institucional.' }}</p>
                </div>
            </div>
        </div>
    </section>

    {# Footer #}
    <footer class="bg-dark text-white py-4 mt-5">
        <div class="container text-center">
            <p class="mb-1">{{ configs['contact_info'] ?? 'Caja de Ahorro - Todos los derechos reservados' }}</p>
            <small class="text-muted">&copy; {{ "now"|date("Y") }} {{ configs['site_title'] ?? 'Caja de Ahorro' }}</small>
        </div>
    </footer>

</body>
</html>