{% extends 'base.html.twig' %}

{% block title %}Correo de Recuperación Enviado - Caja de Ahorro{% endblock %}

{% block body %}
<div class="container mt-5" style="max-width: 500px;">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4 text-center">
            <div class="display-5 text-success mb-3">
                <i class="bi bi-envelope-check"></i>
            </div>
            <h1 class="h4 fw-bold text-dark mb-3">Correo enviado</h1>
            
            <p class="text-secondary mb-3">
                Si existe una cuenta asociada a tu correo electrónico, se acaba de enviar un mensaje que contiene un enlace para restablecer tu contraseña. Este enlace caducará en <strong>1 hora</strong>.
            </p>
            
            <p class="text-muted small mb-4">
                Si no recibes el correo, por favor revisa tu carpeta de spam o intenta nuevamente.
            </p>

            <a href="{{ path('app_login') }}" class="btn btn-outline-primary w-100 fw-bold">
                <i class="bi bi-arrow-left me-1"></i> Volver al inicio de sesión
            </a>
        </div>
    </div>
</div>
{% endblock %}